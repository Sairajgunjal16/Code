# Select relevant columns for analysis
selected_columns = [
    'Severity', 'Start_Lat', 'Start_Lng', 'City', 'State',
    'Temperature(F)', 'Humidity(%)', 'Visibility(mi)',
    'Weather_Condition', 'Sunrise_Sunset', 'Civil_Twilight'
]

df_clean = df[selected_columns].copy()

# Handle missing values
df_clean = df_clean.dropna()

# Convert time-related features
df_clean['Is_Night'] = df_clean['Sunrise_Sunset'].apply(
    lambda x: 1 if x == 'Night' else 0
)

# Create simplified weather categories
def categorize_weather(condition):
    condition = str(condition).lower()
    if 'rain' in condition:
        return 'Rainy'
    elif 'snow' in condition or 'ice' in condition:
        return 'Snowy'
    elif 'fog' in condition or 'mist' in condition:
        return 'Foggy'
    elif 'clear' in condition or 'fair' in condition:
        return 'Clear'
    else:
        return 'Other'

df_clean['Weather_Type'] = df_clean['Weather_Condition'].apply(categorize_weather)

print("Cleaned dataset shape:", df_clean.shape)
print("\nSample of processed data:")
print(df_clean.head())
