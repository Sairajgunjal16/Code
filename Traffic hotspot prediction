    time_options = {'1': 'Night', '2': 'Day', '3': 'Both'}
    selected_time = time_options.get(time_choice, 'Both')

    # Weather Condition Selection
    print("\nSELECT WEATHER CONDITION:")
    print("1. Clear")
    print("2. Rainy")
    print("3. Foggy")
    print("4. Snowy")
    print("5. All Conditions")
    weather_choice = input("Enter your choice (1/2/3/4/5): ").strip()
    weather_options = {'1': 'Clear', '2': 'Rainy', '3': 'Foggy', '4': 'Snowy', '5': 'All'}
    selected_weather = weather_options.get(weather_choice, 'All')

    # City Selection
    print("\nSELECT CITY:")
    top_cities = night_hotspots.head(5)
    for i, (_, row) in enumerate(top_cities.iterrows(), 1):
        print(f"{i}. {row['City']}, {row['State']}")
    print("6. Custom City Input")

    city_choice = input("Enter your choice (1-6): ").strip()

    if city_choice.isdigit() and 1 <= int(city_choice) <= 5:
        selected_city = top_cities.iloc[int(city_choice) - 1]['City']
        selected_state = top_cities.iloc[int(city_choice) - 1]['State']
        accident_count = top_cities.iloc[int(city_choice) - 1]['Night_Accidents']
    else:
        selected_city = input("Enter city name: ").strip()
        selected_state = input("Enter state name: ").strip()
        city_data = night_hotspots[
            (night_hotspots['City'].str.lower() == selected_city.lower()) &
            (night_hotspots['State'].str.lower() == selected_state.lower())
        ]
        accident_count = city_data['Night_Accidents'].iloc[0] if len(city_data) > 0 else 50

    return selected_city, selected_state, accident_count, selected_time, selected_weather

# Run interactive analysis
