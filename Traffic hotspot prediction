# Generate recommendations
def generate_recommendations(city, state, accident_count, time_of_day, weather_condition):
    recommendations = []

    if accident_count > 100:
        recommendations.append(f"Increase traffic patrols in {city}, {state}")
        recommendations.append(f"Install additional street lighting")

    if time_of_day == 'Night':
        recommendations.append(f"Implement night-time speed enforcement")
        recommendations.append(f"Add reflective road markings")

    if weather_condition == 'Rainy':
        recommendations.append(f"Improve drainage systems")

    elif weather_condition == 'Foggy':
        recommendations.append(f"Install fog warning systems")

    elif weather_condition == 'Snowy':
        recommendations.append(f"Enhance snow removal operations")

    recommendations.append(f"Conduct safety audit of high-accident areas")

    return recommendations

# Interactive user input system
def interactive_analysis():
    print("\n\nACCIDENT HOTSPOT ANALYSIS SYSTEM")

    # Time of Day Selection
    print("SELECT TIME OF DAY:")
    print("1. Night")
    print("2. Day")
    print("3. Both")
